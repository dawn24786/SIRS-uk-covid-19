# ── Shared SIRS with piecewise-constant β ────────────────────────────────────
def sirs_pw(y, t, beta_arr):
    S, I, R = y;  N = S + I + R
    ti   = min(int(round(t)), len(beta_arr) - 1)
    beta = beta_arr[ti]
    return [
        -beta*S*I/N + omega_ode*R,
         beta*S*I/N - gamma_ode*I,
         gamma_ode*I - omega_ode*R,
    ]
# Note: γ and ω fixed at ODE baseline values to reduce parameter space.

def make_beta_arr(log_betas, bps, T_):
    betas = np.exp(np.clip(log_betas, -2.5, 1.5))
    arr   = np.full(T_, betas[0])
    bps_s = np.sort(np.clip(np.round(bps).astype(int), 5, T_-5))
    segs  = np.concatenate([[0], bps_s, [T_]])
    for i in range(len(segs)-1):
        arr[segs[i] : segs[i+1]] = betas[i]
    return arr

def fit_piecewise(K):
    print(f"\n  Fitting K={K} …")
    K_ = K   # capture

    def loss(p):
        lb  = p[:K_]
        bps = p[K_ : K_+(K_-1)]
        k   = np.exp(p[-1])
        arr = make_beta_arr(lb, bps, T)
        try:
            sol = odeint(sirs_pw, [0.9999, 1e-6, 1e-4], t_obs,
                         args=(arr,), full_output=False,
                         rtol=1e-4, atol=1e-6, mxstep=300)
            return np.mean((sol[:,1]*k - obs_n)**2)
        except Exception:
            return 1e6

    # Global search via differential evolution
    bounds = ([(-2.5, 1.5)] * K_
              + [(5, T-5)] * (K_-1)
              + [(-2, 6)])
    res_de = differential_evolution(
        loss, bounds, seed=42, maxiter=400,
        popsize=12, tol=1e-6, workers=1, polish=True)

    # Polish with Powell
    res    = minimize(loss, res_de.x, method="Powell",
                      options=dict(maxiter=5000, xtol=1e-10, ftol=1e-12))
    p      = res.x

    bps_fit = np.sort(np.clip(np.round(p[K_:K_+(K_-1)]).astype(float), 5, T-5))
    k_fit   = np.exp(p[-1])
    arr_fit = make_beta_arr(p[:K_], bps_fit, T)
    betas_fit = np.exp(np.clip(p[:K_], -2.5, 1.5))

    sol_fit = odeint(sirs_pw, [0.9999, 1e-6, 1e-4], t_obs,
                     args=(arr_fit,), rtol=1e-5, atol=1e-8)
    I_fit   = sol_fit[:,1] * k_fit * I_scale
    resid   = obs - I_fit
    mse_    = np.mean(resid**2)
    rmse    = np.sqrt(mse_)
    r2_     = 1 - np.sum(resid**2)/np.sum((obs-obs.mean())**2)
    n_p     = K_ + (K_-1) + 3          # betas + bps + (γ,ω fixed) + k
    LL_     = -T/2 * np.log(mse_)
    aic     = 2*n_p - 2*LL_
    bic     = np.log(T)*n_p - 2*LL_

    bps_int  = bps_fit.astype(int)
    bp_dates = [uk_weekly["week_start"].iloc[bp].strftime("%Y-%m-%d")
                for bp in bps_int]
    print(f"    β segments : {betas_fit.round(4)}")
    print(f"    Breakpoints: weeks {bps_int}  =  {bp_dates}")
    print(f"    RMSE={rmse:,.0f}  R²={r2_:.4f}  AIC={aic:.1f}  BIC={bic:.1f}")

    return dict(
        K=K_, log_betas=np.clip(p[:K_], -2.5, 1.5),
        betas=betas_fit, bps=bps_fit, bps_int=bps_int,
        bp_dates=bp_dates, k=k_fit,
        I_fit=I_fit, resid=resid, rmse=rmse, r2=r2_,
        aic=aic, bic=bic, n_params=n_p, beta_arr=arr_fit,
    )

pw = {}
for K in [4, 6, 8]:
    pw[K] = fit_piecewise(K)

