    rS = dSIR[:,0] - (-beta*S*I/N + omega*R)
    rI = dSIR[:,1] - ( beta*S*I/N - gamma*I)
    rR = dSIR[:,2] - ( gamma*I    - omega*R)
    Lp = np.mean(rS**2 + rI**2 + rR**2)
    return Ld + lam * Lp

