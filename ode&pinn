# ── MLP helpers ───────────────────────────────────────────────────────────────
ARCH = [1, 16, 32, 16, 3]

def mlp_n_params():
    return sum(ARCH[i]*ARCH[i+1] + ARCH[i+1] for i in range(len(ARCH)-1))

def mlp_forward(t_in, params):
    """t_in: (N,) normalised → output: (N, 3) softmax → sums to 1."""
    idx = 0
    h   = t_in.reshape(-1, 1)
    for i in range(len(ARCH)-1):
        ni, no = ARCH[i], ARCH[i+1]
        W = params[idx : idx + ni*no].reshape(no, ni); idx += ni*no
        b = params[idx : idx + no];                    idx += no
        h = h @ W.T + b
        if i < len(ARCH)-2:
            h = np.tanh(h)
    e = np.exp(h - h.max(axis=1, keepdims=True))
    return e / e.sum(axis=1, keepdims=True)

def mlp_d_dt(t_pts, params, eps=0.08):
    """Numerical derivative of MLP output w.r.t. t."""
    return (mlp_forward(t_pts + eps, params)
          - mlp_forward(t_pts - eps, params)) / (2 * eps)

