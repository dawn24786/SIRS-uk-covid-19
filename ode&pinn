# STAGE 3 — ODE BASELINE  (Step 10)
# ═════════════════════════════════════════════════════════════════════════════
print("\n" + "═"*65)
print("STAGE 3 — ODE BASELINE  (Step 10)")
print("═"*65)

# Use smoothed series as model target
obs       = obs_smooth.copy()
I_scale   = obs.max()
obs_n     = obs / I_scale           # normalised to [0, 1]

# ── SIRS ODE (via odeint for speed) ──────────────────────────────────────────
def sirs(y, t, beta, gamma, omega):
    S, I, R = y;  N = S + I + R
    return [
        -beta*S*I/N + omega*R,
         beta*S*I/N - gamma*I,
         gamma*I    - omega*R,
    ]

def ode_loss(p):
    """p = [log_beta, log_gamma, log_omega, log_k]"""
    beta, gamma, omega, k = np.exp(p[0]), np.exp(p[1]), np.exp(p[2]), np.exp(p[3])
    if not (0.05 < beta < 5 and 0.05 < gamma < 2 and 1e-6 < omega < 0.5):
        return 1e6
    try:
        sol = odeint(sirs, [0.9999, 1e-6, 1e-4], t_obs,
                     args=(beta, gamma, omega),
                     full_output=False, rtol=1e-5, atol=1e-7, mxstep=500)
        return np.mean((sol[:, 1] * k - obs_n) ** 2)
    except Exception:
        return 1e6

# Multi-start grid search → Nelder-Mead → Powell polish
print("  Multi-start ODE fitting (45 initial points) …")
starts = [
    [np.log(b), np.log(g), np.log(o), np.log(0.001)]
    for b in [0.3, 0.5, 0.8, 1.2, 2.0]
    for g in [0.2, 0.4, 0.7]
    for o in [0.01, 0.03, 0.05]
]
best_r, best_v = None, 1e9
for p0 in starts:
    r = minimize(ode_loss, p0, method="Nelder-Mead",
                 options=dict(maxiter=2000, xatol=1e-8, fatol=1e-10))
    if r.fun < best_v:
        best_v, best_r = r.fun, r

res_ode = minimize(ode_loss, best_r.x, method="Powell",
                   options=dict(maxiter=5000, xtol=1e-10, ftol=1e-12))
p_ode = res_ode.x
beta_ode, gamma_ode, omega_ode, k_ode = (
    np.exp(p_ode[0]), np.exp(p_ode[1]), np.exp(p_ode[2]), np.exp(p_ode[3])
)
R0_ode    = beta_ode / gamma_ode

sol_ode   = odeint(sirs, [0.9999, 1e-6, 1e-4], t_obs,
                   args=(beta_ode, gamma_ode, omega_ode),
                   rtol=1e-6, atol=1e-8)
I_ode     = sol_ode[:, 1] * k_ode * I_scale
resid_ode = obs - I_ode
rmse_ode  = np.sqrt(np.mean(resid_ode**2))
r2_ode    = 1 - np.sum(resid_ode**2) / np.sum((obs - obs.mean())**2)
mse_ode   = np.mean(resid_ode**2)
LL_ode    = -T/2 * np.log(mse_ode)
aic_ode   = 2*4 - 2*LL_ode
