def pinn_loss(x, lam=0.5):
    """x = [net_params | log_beta, log_gamma, log_omega, log_k]"""
    pn   = x[:NP];  pp = x[NP:]
    beta, gamma, omega, k = (np.exp(pp[0]), np.exp(pp[1]),
                              np.exp(pp[2]), np.exp(pp[3]))
    SIR    = mlp_forward(t_n, pn)
    I_pred = SIR[:, 1] * k
