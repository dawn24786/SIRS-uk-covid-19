fig.patch.set_facecolor(C["bg"])
for ax, K in zip(axes, [4, 6, 8]):
    r = pw[K]
    ax.fill_between(t_obs, obs_raw, alpha=0.08, color=C["c1"])
    ax.plot(t_obs, obs,       lw=2,   color=C["c1"],  label="Observed")
    ax.plot(t_obs, r["I_fit"],lw=2.5, color=Kcols[K], ls="--", label=f"K={K} fit")
    segs = np.concatenate([[0], r["bps"], [T]])
    for i in range(len(segs)-1):
        ax.axvspan(segs[i], segs[i+1],
