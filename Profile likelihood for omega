"""
Figure 4A — Clean Profile Likelihood for omega
================================================
Generates figure4A_final.png as described in the paper.

Requirements:
  - check_results.npz  (produced by checks_fast.py)
  - numpy, matplotlib

Usage:
  python figure4A_script.py
"""

import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker

# ── load validated profile likelihood results ──────────────────────────────
d    = np.load('check_results.npz', allow_pickle=True)
OG   = d['OG']          # omega grid (15 log-spaced points)
dl2  = d['dl2']         # delta-LL for K=6, k re-optimised
om2  = float(d['om_mle2'][0])
THRESHOLD = 1.92        # chi-squared(1) / 2  →  95% CI boundary

# ── colour palette ─────────────────────────────────────────────────────────
BG     = '#0D1117'
PANEL  = '#161B22'
GRIDC  = '#21262D'
GREEN  = '#3FB950'
RED    = '#FF7B72'
TXT    = '#E6EDF3'
SUB    = '#8B949E'
PURPLE = '#BC8CFF'

plt.rcParams.update({
    'figure.facecolor': BG,    'axes.facecolor':  PANEL,
    'axes.edgecolor':   GRIDC, 'axes.labelcolor': TXT,
    'xtick.color':      SUB,   'ytick.color':     SUB,
    'text.color':       TXT,   'grid.color':      GRIDC,
    'grid.linestyle':   '--',  'grid.linewidth':  0.5,
    'font.family':      'DejaVu Sans',
    'legend.facecolor': PANEL, 'legend.edgecolor': GRIDC,
})

ci_mask = dl2 <= THRESHOLD

fig, ax = plt.subplots(figsize=(8, 5.5), facecolor=BG)
fig.subplots_adjust(left=0.12, right=0.97, top=0.88, bottom=0.13)

# ── shaded 95% CI region ───────────────────────────────────────────────────
ax.fill_between(OG, 0, THRESHOLD,
                where=ci_mask,
                color=GREEN, alpha=0.18, zorder=1,
                label='95% confidence region within scanned grid')

# ── main delta-LL curve ────────────────────────────────────────────────────
ax.semilogx(OG, dl2, color=PURPLE, lw=2.8, zorder=3,
            label=r'$\Delta\ell(\omega) = \ell_{\max} - \ell(\omega)$')

# ── 95% CI threshold line ──────────────────────────────────────────────────
ax.axhline(THRESHOLD, color=RED, lw=2.0, ls='--', zorder=2,
           label=r'95% CI threshold   $\Delta\ell = 1.92$')

# ── MLE marker ────────────────────────────────────────────────────────────
ax.scatter([om2], [0.0], color=GREEN, s=70, zorder=5,
           label=f'MLE   $\\omega = {om2:.2e}$ /wk')

# ── y = 0 reference ───────────────────────────────────────────────────────
ax.axhline(0, color=TXT, lw=0.6, alpha=0.35, zorder=1)

# ── annotation box ────────────────────────────────────────────────────────
annot = (
    '95% CI spans entire scanned range\n'
    r'$\omega \in [10^{-6},\ 0.20]$ /wk' + '\n\n'
    r'$\Rightarrow$ Weak practical identifiability'
)
ax.text(0.975, 0.97, annot,
        transform=ax.transAxes,
        fontsize=9.5, color=TXT, va='top', ha='right',
        linespacing=1.55,
        bbox=dict(boxstyle='round,pad=0.55',
                  fc=PANEL, ec=GREEN, lw=1.6, alpha=0.95))

# ── axes labels ───────────────────────────────────────────────────────────
ax.set_xlabel(r'$\omega$  (immunity-loss rate,  /week,  log scale)',
              color=SUB, fontsize=11, labelpad=6)
ax.set_ylabel(r'$\Delta\ell(\omega) = \ell_{\max} - \ell(\omega)$',
              color=SUB, fontsize=11, labelpad=6)

ax.set_xlim(OG[0] * 0.7, OG[-1] * 1.4)
ax.set_ylim(-0.05, max(dl2.max(), THRESHOLD) * 1.30)
ax.xaxis.set_major_formatter(mticker.LogFormatterSciNotation())
ax.tick_params(axis='both', labelsize=9)

# ── grid ──────────────────────────────────────────────────────────────────
ax.grid(True, which='major', alpha=0.35)
ax.grid(True, which='minor', alpha=0.12)

# ── title (no "Figure 4A" prefix — label belongs in caption only) ─────────
ax.set_title(
    'Profile Likelihood for $\\omega$  (Immunity Waning Rate)\n'
    'K = 6 piecewise SIRS  ·  $k$ re-optimised at each $\\omega$  '
    '·  UK weekly COVID-19 data',
    fontsize=10.5, fontweight='bold', color=TXT, pad=10)

# ── legend ────────────────────────────────────────────────────────────────
ax.legend(fontsize=8.8, framealpha=0.45, loc='upper left',
          borderpad=0.7, labelspacing=0.5)

plt.savefig('figure4A_final.png', dpi=180,
            bbox_inches='tight', facecolor=BG)
print(f"Saved figure4A_final.png")
print(f"  delta_max = {dl2.max():.3f}  (threshold = {THRESHOLD})")
print(f"  CI coverage = {ci_mask.sum()}/{len(OG)} = {ci_mask.sum()/len(OG):.0%}")
print(f"  omega MLE  = {om2:.3e} /wk")
